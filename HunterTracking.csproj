<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- 0.1.8: keep AssemblyVersion/FileVersion in sync with the package Version. -->
    <Version>0.1.8</Version>
    <AssemblyVersion>0.1.8.0</AssemblyVersion>
    <FileVersion>0.1.8.0</FileVersion>
  </PropertyGroup>

  <!-- 0.1.6: the EcoModKit Unity project lives at repo root for reference (0.1.5 bundle experiment, reverted) but must not be compiled into the C# mod. 0.1.8: exclude the reference example files (attachment research notes). -->
  <ItemGroup>
    <Compile Remove="EcoModKit\**" />
    <Compile Remove="Example code.cs" />
    <Compile Remove="Example code 2.cs" />
    <EmbeddedResource Remove="EcoModKit\**" />
    <None Remove="EcoModKit\**" />
    <Content Remove="EcoModKit\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eco.ReferenceAssemblies" Version="0.14.2.1-beta-release-1106" />
    <PackageReference Include="Fody" Version="6.8.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StrangeLoopGames.PropertyChanged.Fody" Version="3.4.2-slg.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
